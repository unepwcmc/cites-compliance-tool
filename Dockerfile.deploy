ARG RUBY_VERSION
FROM --platform=linux/amd64 ruby:${RUBY_VERSION}-slim

ENV NODE_ENV="production" \
  RAILS_ENV="production" \
  BUNDLE_DEPLOYMENT="1" \
  BUNDLE_PATH="/usr/local/bundle" \
  BUNDLE_WITHOUT="development"

# Install dependencies
# Debian bullseye reached EOL on 2026-09-08: security.debian.org dropped the
# bullseye-security pool, so its .debs now 404 and its Release file has expired.
# `apt-get update` therefore fails, and because the next layer chains
# `update && install`, the whole build exits 100.
#
# Drop the dead suite rather than repointing it: archive.debian.org carries no
# bullseye-security either ("does not have a Release file"), which fails
# `apt-get update` just the same. bullseye main and bullseye-updates still
# resolve and supply every package installed below.
#
# This pins the build to the last published bullseye packages and takes NO
# further security updates. A stopgap to keep staging deployable until this app
# moves off Ruby 2.6.10 / bullseye.
RUN sed -i '/security\.debian\.org/d' /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until

RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
  curl build-essential zlib1g-dev git libpq-dev \
  # Editor
  vim nano \
  # For nvm and Node.js
  libffi-dev python python-is-python2 \
  # For mimemagic gem
  shared-mime-info \
  # Clean up
  && rm -rf /var/lib/apt/lists/*

# Install Ruby bundler
RUN bash -c "gem install bundler -v '1.17.3'"

# Force baseline x86-64 so native extensions (e.g. ffi) don't use AVX2/AVX512
# instructions that may be unavailable on the target Proxmox VM CPU (seen as a
# SIGILL crash in the ffi gem when this was missing on other apps).
ENV CFLAGS="-march=x86-64" \
    CXXFLAGS="-march=x86-64"

# Leonardo: I tried installing via apt-get using the source (https://deb.nodesource.com/setup_10.x),
# but it ended up installing version 12.
# Install Node.js 10.24.1 manually
RUN curl -fsSL https://nodejs.org/dist/v10.24.1/node-v10.24.1-linux-x64.tar.xz \
  | tar -xJ -C /usr/local --strip-components=1

# Install Yarn globally using npm
RUN npm install -g yarn

# Rails app lives here
WORKDIR /rails

# Install application gems
COPY Gemfile Gemfile.lock package.json yarn.lock ./
RUN bundle install && \
  yarn install --frozen-lockfile

# Copy application code
COPY . .

# Precompiling assets for production
# TODO: need to change when upgrade Rails.
RUN SECRET_KEY_BASE=dummy ./bin/rails assets:precompile

# Run and own only the runtime files as a non-root user for security
RUN groupadd --system --gid 1000 rails && \
  useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash && \
  chown -R rails:rails db log tmp
USER 1000:1000

# Entrypoint prepares the database.
ENTRYPOINT ["/rails/bin/docker-entrypoint"]

EXPOSE 80
CMD ["./bin/rails", "server"]
